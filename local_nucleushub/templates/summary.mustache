{{!
    @template local_nucleushub/summary

    Facts about a course, shown above the promote and publish forms.

    Context variables required for this template:
    * rows - label, value, lines (text).
    * note - Optional note under the list.

    Example context (json):
    {
        "rows": [
            {"label": "Identifier", "value": "intro-to-safeguarding", "lines": []},
            {"label": "Unpublished changes", "value": "3", "lines": [{"text": "Activities added: 2"}, {"text": "Sections updated: 1"}]}
        ],
        "note": "Suggested: Minor - Added: 2. Updated: 0. Nothing removed."
    }
}}
<dl class="row local-nucleushub-summary">
    {{#rows}}
    <dt class="col-sm-4 col-lg-3">{{label}}</dt>
    <dd class="col-sm-8 col-lg-9">
        {{value}}
        {{#lines}}<span class="d-block small text-muted">{{text}}</span>{{/lines}}
    </dd>
    {{/rows}}
</dl>
{{#note}}
<p>{{.}}</p>
{{/note}}
