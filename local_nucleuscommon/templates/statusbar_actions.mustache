{{!
    @template local_nucleuscommon/statusbar_actions

    Links in the Nucleus bar: the main action for this page, then the
    Nucleus portal (which opens in a new window).

    Context variables required for this template:
    * actions - label, url, primary, external.

    Example context (json):
    {
        "actions": [
            {"label": "Pull v1.1.0", "url": "https://example.com/local/nucleusspoke/versions.php?action=pull&id=4",
             "primary": true, "external": false},
            {"label": "Nucleus portal", "url": "https://nucleus.dklabs.co.uk", "primary": false, "external": true}
        ]
    }
}}
{{#actions}}
<a class="local-nucleuscommon-bar-action{{#primary}} local-nucleuscommon-bar-action-primary{{/primary}}{{#external}} local-nucleuscommon-bar-action-external{{/external}}"
        href="{{url}}"{{#external}} target="_blank" rel="noopener"{{/external}}>{{label}}{{#external}} {{#pix}}i/externallink, core, {{#str}}opensinnewwindow{{/str}}{{/pix}}{{/external}}</a>
{{/actions}}
