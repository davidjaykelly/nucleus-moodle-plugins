{{!
    @template local_nucleuscommon/statusbar_segments

    The short facts in the Nucleus bar. Something that needs attention
    is marked in the accent colour and always says so in words.

    Context variables required for this template:
    * segments - text, attention.

    Example context (json):
    {
        "segments": [
            {"text": "v1.0.0", "attention": false},
            {"text": "Updates: 1", "attention": true}
        ]
    }
}}
{{#segments}}
<span class="local-nucleuscommon-bar-seg{{#attention}} local-nucleuscommon-bar-seg-attention{{/attention}}">{{text}}</span>
{{/segments}}
